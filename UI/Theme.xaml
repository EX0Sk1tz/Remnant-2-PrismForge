<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:R2PrismRuntime.UI"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Boolean x:Key="True">True</sys:Boolean>

    <!-- ═══ Palette: soot, ash, bone and ember ═══ -->
    <Color x:Key="Soot">#17181A</Color>
    <Color x:Key="Char">#1D1F21</Color>
    <Color x:Key="Ash">#25282A</Color>
    <Color x:Key="AshHi">#2F3336</Color>
    <Color x:Key="Hairline">#3E4341</Color>
    <Color x:Key="Bronze">#6A645A</Color>
    <Color x:Key="Bone">#ECE5D8</Color>
    <Color x:Key="BoneDim">#B2AA9C</Color>
    <Color x:Key="BoneFaint">#817B70</Color>
    <Color x:Key="Ember">#C8323A</Color>
    <Color x:Key="EmberHi">#E24A50</Color>
    <Color x:Key="Pending">#F08A3C</Color>

    <SolidColorBrush x:Key="SootBrush" Color="{StaticResource Soot}"/>
    <SolidColorBrush x:Key="CharBrush" Color="{StaticResource Char}"/>
    <SolidColorBrush x:Key="AshBrush" Color="{StaticResource Ash}"/>
    <SolidColorBrush x:Key="AshHiBrush" Color="{StaticResource AshHi}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}"/>
    <SolidColorBrush x:Key="BronzeBrush" Color="{StaticResource Bronze}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Bone}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource BoneDim}"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource BoneFaint}"/>
    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource Ember}"/>
    <SolidColorBrush x:Key="EmberHiBrush" Color="{StaticResource EmberHi}"/>
    <SolidColorBrush x:Key="PendingBrush" Color="{StaticResource Pending}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#6CC4C0"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#E3B55C"/>
    <SolidColorBrush x:Key="BadBrush" Color="#E0533F"/>

    <FontFamily x:Key="UiFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <ui:TrackedConverter x:Key="Tracked"/>
    <ui:BoolToVisibilityConverter x:Key="BoolVis"/>
    <ui:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True"/>
    <ui:NullToVisibilityConverter x:Key="NullVis"/>
    <ui:NullToVisibilityConverter x:Key="NullVisInv" Invert="True"/>
    <ui:CountToVisibilityConverter x:Key="CountVis"/>
    <ui:CountToVisibilityConverter x:Key="CountVisInv" Invert="True"/>
    <ui:ToneToBrushConverter x:Key="ToneBrush"/>
    <ui:XpConverter x:Key="Xp"/>
    <ui:XpConverter x:Key="Float" AllowNegative="True"/>
    <ui:EqualsConverter x:Key="Equals"/>
    <ui:AllEqualConverter x:Key="AllEqual"/>

    <!-- Title bar navigation tab; Tag=True marks the active page -->
    <Style x:Key="NavTab" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="14,0" VerticalAlignment="Center"/>
                        <Rectangle x:Name="bar" Height="2" VerticalAlignment="Bottom" Margin="10,0"
                                   Fill="{StaticResource EmberBrush}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chip; Tag=True marks the active filter -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="10,4" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextDimBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource EmberBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="#4A171B"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Key-art lighting: cool light from above, embers from below -->
    <RadialGradientBrush x:Key="SkyGlow" Center="0.55,-0.1" GradientOrigin="0.55,-0.1" RadiusX="0.75" RadiusY="0.7">
        <GradientStop Color="#2A9FD6D0" Offset="0"/>
        <GradientStop Color="#10E3C58A" Offset="0.45"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="FireGlow" Center="0.5,1.15" GradientOrigin="0.5,1.15" RadiusX="0.8" RadiusY="0.55">
        <GradientStop Color="#40F08A3C" Offset="0"/>
        <GradientStop Color="#18C8323A" Offset="0.5"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>

    <!-- Vignette laid over the whole window -->
    <RadialGradientBrush x:Key="Vignette" Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.85" RadiusY="0.9">
        <GradientStop Color="#00000000" Offset="0.45"/>
        <GradientStop Color="#70000000" Offset="1"/>
    </RadialGradientBrush>

    <!-- ═══ Text ═══ -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- ═══ Buttons ═══ -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource AshHiBrush}"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource TextDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource CharBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource EmberBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="#4A171B"/>
        <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}"/>
        <Setter Property="Foreground" Value="#F2E6D3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                        <Border x:Name="glow" BorderThickness="0" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#55E24A50" Offset="0"/>
                                    <GradientStop Color="#00E24A50" Offset="0.8"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Rectangle Height="2" VerticalAlignment="Bottom" Margin="1,0,1,1" Fill="{StaticResource EmberBrush}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="glow" Property="Opacity" Value="1"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource EmberHiBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#361013"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless text button for tertiary actions -->
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="cp" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square − / + stepper buttons -->
    <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>

    <!-- Title bar buttons -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource AshHiBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#A0232B"/>
                            <Setter Property="Foreground" Value="#F2E6D3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Text input ═══ -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource SootBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource EmberHiBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource EmberBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BronzeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource EmberBrush}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BadBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate><AdornedElementPlaceholder/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LevelField" TargetType="TextBox" BasedOn="{StaticResource Field}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0,1"/>
    </Style>

    <!-- ═══ Scrollbar (thin, square) ═══ -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Rectangle x:Name="r" Fill="{StaticResource HairlineBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="r" Property="Fill" Value="{StaticResource BronzeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="r" Property="Fill" Value="{StaticResource TextDimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThumbStyle}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="6"/>
                <Setter Property="MinHeight" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Tooltip ═══ -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource CharBrush}" BorderBrush="{StaticResource BronzeBrush}"
                            BorderThickness="1" Padding="10,7">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Stat picker: a ComboBox whose closed state is a "CHANGE" affordance ═══ -->
    <Style x:Key="PickerItem" TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="10,5" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AshHiBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource EmberBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BronzeBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatPicker" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PickerItem}"/>
        <Setter Property="MaxDropDownHeight" Value="420"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Gem Def="{Binding}" Width="12" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource HairlineBrush}"
                                            BorderThickness="1" Padding="10,0" Height="26">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="lbl" Text="{Binding Converter={StaticResource Tracked}, Source=Change}"
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Path x:Name="chev" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.2"
                                                  Margin="8,1,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextDimBrush}"/>
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AshHiBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource EmberBrush}"/>
                                            <Setter TargetName="chev" Property="Stroke" Value="{StaticResource EmberHiBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-260" VerticalOffset="4"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource CharBrush}" BorderBrush="{StaticResource BronzeBrush}"
                                    BorderThickness="1" Width="340" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.7" Color="Black"/>
                                </Border.Effect>
                                <ScrollViewer Padding="0,4">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group header inside the stat picker -->
    <GroupStyle x:Key="PickerGroup">
        <GroupStyle.HeaderTemplate>
            <DataTemplate>
                <Grid Margin="10,10,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name, Converter={StaticResource Tracked}}" Style="{StaticResource Eyebrow}"
                               Foreground="{StaticResource EmberBrush}"/>
                    <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource HairlineBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>
        </GroupStyle.HeaderTemplate>
    </GroupStyle>
</ResourceDictionary>
